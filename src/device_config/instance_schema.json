{
  "$schema": "http://json-schema.org/draft-09/schema#",
  "title": "Discovery Protocol Schema",
  "description": "Supply status and/or configuration in the message",
  "properties": {
    "configuration": {
      "$ref": "#/$protected/configuration"
    },
    "status": {
      "$ref": "#/$protected/status"
    }
  },
  "$immutable": {
    "null": {
      "type": "null"
    },
    "state": {
      "type": "string",
      "default": "IDLE",
      "enum": [
        "ACTIVE",
        "IDLE"
      ]
    },
    "thumbnail_status": {
      "description": "Thumbnail available if present",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/inputs_ids"
        },
        "local_path": {
          "description": "Protocol supports jpg or png type for thumbnail images.",
          "type": "string",
          "pattern": "^(?:/[^/]+)*/?[^/]+\\.(jpg|png)$"
        }
      },
      "required": [
        "source",
        "local_path"
      ]
    },
    "aes128_passcode": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$",
      "errorMessage": {
        "pattern": "AES-128 passcode must be exactly 32 hexadecimal characters (0-9, a-f, A-F)"
      }
    },
    "aes256_passcode": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "errorMessage": {
        "pattern": "AES-256 passcode must be exactly 64 hexadecimal characters (0-9, a-f, A-F)"
      }
    }
  },
  "$protected": {
    "description": "$Protected: Add/Remove OK but altering existing params is not allowed",
    "status": {
      "properties": {
        "thumbnails": {
          "type": "array",
          "items": {
            "$ref": "#/$immutable/thumbnail_status"
          }
        },
        "system": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "serial": {
              "type": "string"
            },
            "mac_address": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "system_type": {
              "$ref": "#/$protected/system_types"
            },
            "cpu_utilization": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "memory_utilization": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "storage_utilization": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "temperature": {
              "type": "integer"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "serial",
            "manufacturer",
            "system_type",
            "version"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/inputs_ids"
              },
              "state": {
                "$ref": "#/$immutable/state"
              }
            },
            "required": [
              "id",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "channels": {
          "type": "array",
          "maxItems": 2,
          "description": "This is a 2 channel device.",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "$ref": "#/$immutable/state"
              },
              "output_status": {
                "$ref": "#/$protected/output_status"
              },
              "video_status": {
                "$ref": "#/$protected/video_status"
              },
              "audio_status": {
                "$ref": "#/$protected/audio_status"
              }
            },
            "required": [
              "state",
              "output_status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "system",
        "inputs",
        "channels"
      ]
    },
    "configuration": {
      "properties": {
        "channels": {
          "type": "array",
          "maxItems": 2,
          "description": "This is a 2 channel device.",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "$ref": "#/$immutable/state"
              },
              "output_configuration": {
                "description": "Required param: also likely to be accessed programmatically",
                "$ref": "#/$protected/output_configuration"
              },
              "source": {
                "$ref": "#/$defs/inputs_ids"
              },
              "video_configuration": {
                "$ref": "#/$protected/video_configuration"
              },
              "audio_configuration": {
                "$ref": "#/$protected/audio_configuration"
              }
            },
            "required": [
              "state",
              "output_configuration"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "output_configuration": {
      "type": "object",
      "maxProperties": 1,
      "properties": {
        "srt": {
          "$ref": "#/$protected/srt_settings"
        },
        "udp": {
          "$ref": "#/$protected/udp_settings"
        },
        "rtp": {
          "$ref": "#/$protected/rtp_settings"
        }
      },
      "additionalProperties": false
    },
    "srt_ip_address": {
      "type": "string",
      "anyOf": [
        { "format": "ipv4" },
        { "format": "ipv6" }
      ]
    },
    "video_configuration": {
      "type": "object",
      "properties": {
        "resolution": {
          "$ref": "#/$defs/resolutions"
        },
        "framerate": {
          "$ref": "#/$defs/framerates"
        },
        "codec": {
          "$ref": "#/$defs/codec_settings"
        },
        "bitrate": {
          "$ref": "#/$defs/video_bitrate"
        },
        "deinterlacing": {
          "$ref": "#/$defs/deinterlacing"
        },
        "gop_size": {
          "$ref": "#/$defs/gop_size"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "timecode_insertion": {
          "$ref": "#/$defs/timecode_insertion"
        }
      },
      "additionalProperties": false
    },
    "audio_configuration": {
      "properties": {
        "audio_pairs": {
          "type": "array",
          "maxItems": 4,
          "description": "This is a 4 audio pair device.",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "$ref": "#/$immutable/state"
              },
              "language": {
                "$ref": "#/$defs/language"
              },
              "codec": {
                "$ref": "#/$defs/audio_codecs"
              },
              "rate_control": {
                "$ref": "#/$defs/audio_rate_control"
              },
              "bitrate": {
                "$ref": "#/$defs/audio_bitrate"
              },
              "sample_rate": {
                "$ref": "#/$defs/audio_sample_rate"
              },
              "pid": {
                "type": "integer"
              }
            },
            "required": [
              "state"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "maxProperties": 1,
      "properties": {
        "aes128_passcode": {
          "$ref": "#/$immutable/aes128_passcode"
        },
        "aes256_passcode": {
          "$ref": "#/$immutable/aes256_passcode"
        },
        "none": {
          "$ref": "#/$immutable/null"
        }
      }
    },
    "srt_settings": {
      "type": "object",
      "properties": {
        "srt_type": {
          "type": "string",
          "enum": [
            "listener",
            "caller"
          ]
        },
        "stream_id": {
          "type": "string"
        },
        "ip": {
          "$ref": "#/$protected/srt_ip_address"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 49151
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "encryption": {
          "description": "encryption is required, but can specify encryption: {}",
          "$ref": "#/$protected/encryption"
        }
      },
      "required": [
        "srt_type",
        "ip",
        "port",
        "latency_ms",
        "encryption",
        "stream_id"
      ],
      "additionalProperties": false
    },
    "udp_settings": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "additionalProperties": false
    },
    "rtp_settings": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "fec": {
          "description": "FEC with RTP is optional, must include row and column if used",
          "type": "object",
          "properties": {
            "row": {
              "type": "integer"
            },
            "column": {
              "type": "integer"
            }
          },
          "required": [
            "row",
            "column"
          ]
        }
      },
      "required": [
        "ip",
        "port"
      ],
      "additionalProperties": false
    },
    "output_status": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$immutable/state"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "video_status": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$immutable/state"
        },
        "bitrate": {
          "$ref": "#/$defs/video_bitrate_status"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "state",
        "bitrate",
        "metadata"
      ],
      "additionalProperties": false
    },
    "audio_status": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$immutable/state"
        },
        "bitrate": {
          "$ref": "#/$defs/audio_bitrate_status"
        }
      },
      "required": [
        "state",
        "bitrate"
      ],
      "additionalProperties": false
    },
    "system_types": {
      "type": "string",
      "enum": [
        "ENCODER",
        "DECODER",
        "CAMERA"
      ]
    }
  },
  "$defs": {
    "inputs_ids": {
      "type": "string",
      "description": "List all available inputs on the device by name",
      "enum": [
        "SDI-1",
        "HDMI-1"
      ]
    },
    "audio_bitrate_status": {
      "description": "Units are commonly kbps",
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "language": {
      "description": "3 letter, ISO 639-2 language code",
      "type": "string",
      "default": "eng",
      "pattern": "^[a-z]{3}$"
    },
    "audio_codecs": {
      "type": "string",
      "enum": [
        "passthrough",
        "aac",
        "opus"
      ]
    },
    "audio_rate_control": {
      "type": "string",
      "default": "vbr",
      "enum": [
        "vbr",
        "cbr"
      ]
    },
    "audio_bitrate": {
      "type": "integer",
      "default": 10000,
      "minimum": 0,
      "maximum": 500000
    },
    "audio_sample_rate": {
      "type": "integer",
      "default": 48000,
      "enum": [
        32000,
        44100,
        48000,
        96000,
        192000
      ]
    },
    "video_bitrate_status": {
      "description": "Units are commonly kbps",
      "type": "integer",
      "minimum": 0,
      "maximum": 20000000
    },
    "resolutions": {
      "type": "string",
      "default": "1920x1080",
      "enum": [
        "passthrough",
        "7680x4320",
        "3840x2160",
        "3840x1080",
        "2560x1440",
        "2560x1080",
        "1920x1080",
        "1280x720",
        "1024x780",
        "1600x900",
        "1280x720",
        "720x576",
        "720x480",
        "640x480"
      ]
    },
    "framerates": {
      "type": "integer",
      "default": 60,
      "enum": [
        2997,
        5994,
        24,
        25,
        30,
        48,
        50,
        60
      ]
    },
    "h264_settings": {
      "profile": {
        "$ref": "#/$defs/h264_profiles"
      },
      "rate_control": {
        "type": "string",
        "default": "vbr",
        "enum": [
          "vbr",
          "cbr"
        ]
      },
      "qp_settings": {
        "type": "string",
        "default": "high_quality",
        "enum": [
          "high_quality",
          "balanced",
          "size_optimized",
          "dynamic"
        ]
      }
    },
    "h265_settings": {
      "profile": {
        "$ref": "#/$defs/h265_profiles"
      },
      "rate_control": {
        "type": "string",
        "default": "vbr",
        "enum": [
          "vbr",
          "cbr"
        ]
      },
      "qp_settings": {
        "type": "string",
        "default": "high_quality",
        "enum": [
          "high_quality",
          "balanced",
          "size_optimized",
          "dynamic"
        ]
      }
    },
    "av1_settings": {
      "profile": {
        "$ref": "#/$defs/av1_profiles"
      },
      "rate_control": {
        "type": "string",
        "default": "qvbr",
        "enum": [
          "qvbr",
          "vbr",
          "cbr"
        ]
      },
      "qp_settings": {
        "type": "string",
        "default": "high_quality",
        "enum": [
          "high_quality",
          "balanced",
          "size_optimized",
          "dynamic"
        ]
      }
    },
    "h264_profiles": {
      "type": "string",
      "default": "main",
      "enum": [
        "baseline",
        "main",
        "high",
        "high 10",
        "high 4:2:2"
      ]
    },
    "h265_profiles": {
      "type": "string",
      "default": "main",
      "enum": [
        "main",
        "high",
        "high 4:2:2",
        "high 4:4:4"
      ]
    },
    "av1_profiles": {
      "type": "string",
      "default": "main",
      "enum": [
        "main",
        "high",
        "professional"
      ]
    },
    "codec_settings": {
      "h264": {
        "$ref": "#/$defs/h264_settings"
      },
      "h265": {
        "$ref": "#/$defs/h265_settings"
      },
      "av1": {
        "$ref": "#/$defs/av1_settings"
      }
    },
    "video_bitrate": {
      "type": "integer",
      "description": "Units are kbps",
      "default": 25000,
      "minimum": 250,
      "maximum": 500000
    },
    "deinterlacing": {
      "type": "string",
      "default": "motion_adaptive",
      "enum": [
        "none",
        "weave",
        "bob",
        "blend",
        "motion_adaptive",
        "yadif",
        "motion_compensated"
      ]
    },
    "qp_settings": {
      "type": "string",
      "default": "high_quality",
      "enum": [
        "high_quality",
        "balanced",
        "size_optimized"
      ]
    },
    "gop_size": {
      "type": "integer",
      "description": "Units are seconds",
      "default": 3,
      "minimum": 1,
      "maximum": 6
    },
    "metadata": {
      "type": "string",
      "default": "none",
      "enum": [
        "none",
        "cea708",
        "smpte2038",
        "scte35",
        "afd",
        "id3",
        "hdr"
      ]
    },
    "timecode_insertion": {
      "type": "string",
      "default": "none",
      "enum": [
        "none",
        "auto"
      ]
    }
  }
}
