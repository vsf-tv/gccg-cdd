                    {
                        "type": "object",
                        "title": "streamId",
                        "properties": {
                            "streamId": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "streamId"
                        ]
                    }
                ]
            },
            "Setting": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "info": {
                        "type": "string"
                    },
                    "enums": {
                        "$ref": "#/components/schemas/EnumValues"
                    },
                    "ranges": {
                        "$ref": "#/components/schemas/RangeValues"
                    }
                },
                "required": [
                    "id",
                    "info",
                    "name"
                ]
            },
            "SettingProfile": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "SettingsChoice": {
                "oneOf": [
                    {
                        "type": "object",
                        "title": "simpleSettings",
                        "properties": {
                            "simpleSettings": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/IdAndValue"
                                }
                            }
                        },
                        "required": [
                            "simpleSettings"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "profile",
                        "properties": {
                            "profile": {
                                "$ref": "#/components/schemas/SettingProfile"
                            }
                        },
                        "required": [
                            "profile"
                        ]
                    }
                ]
            },
            "SrtCallerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "port": {
                        "type": "number",
                        "maximum": 65535,
                        "minimum": 1
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    }
                },
                "required": [
                    "ip",
                    "minimumLatencyMilliseconds",
                    "port"
                ]
            },
            "SrtListenerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "type": "string"
                    },
                    "port": {
                        "type": "number",
                        "maximum": 65535,
                        "minimum": 1024
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    },
                    "interface": {
                        "type": "string"
                    }
                },
                "required": [
                    "minimumLatencyMilliseconds",
                    "port"
                ]
            },
            "StatusValue": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "info": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "required": [
                    "info",
