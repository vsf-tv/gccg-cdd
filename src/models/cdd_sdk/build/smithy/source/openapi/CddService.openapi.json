    "components": {
        "schemas": {
            "Channel": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "channelType": {
                        "$ref": "#/components/schemas/ChannelType"
                    },
                    "simpleSettings": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Setting"
                        }
                    },
                    "profiles": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProfileDefinition"
                        }
                    },
                    "connectionProtocols": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SupportedProtocol"
                        }
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            },
            "ChannelConfiguration": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "state": {
                        "$ref": "#/components/schemas/ChannelState"
                    },
                    "settings": {
                        "$ref": "#/components/schemas/SettingsChoice"
                    },
                    "connection": {
                        "$ref": "#/components/schemas/Connection"
                    },
                    "health": {
                        "$ref": "#/components/schemas/Health"
                    }
                },
                "required": [
                    "id",
                    "state"
                ]
            },
            "ChannelState": {
                "type": "string",
                "enum": [
                    "ACTIVE",
                    "IDLE"
                ]
            },
            "ChannelStatus": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "state": {
                        "$ref": "#/components/schemas/ChannelState"
                    },
                    "status": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StatusValue"
                        }
                    }
                },
                "required": [
                    "id",
                    "state",
                    "status"
                ]
            },
            "ChannelType": {
                "type": "string",
                "enum": [
                    "SOURCE",
                    "DESTINATION"
                ]
            },
            "ConfigurationData": {
                "type": "object",
                "properties": {
                    "updateId": {
                        "type": "string"
                    },
                    "payload": {
                        "$ref": "#/components/schemas/DeviceConfiguration"
                    }
                }
            },
            "ConnectRequestContent": {
                "type": "object",
                "properties": {
                    "registration": {
                        "$ref": "#/components/schemas/DeviceRegistration"
                    },
                    "hostId": {
                        "type": "string"
                    }
                },
                "required": [
                    "hostId",
                    "registration"
                ]
            },
            "ConnectResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    },
                    "deviceId": {
                        "type": "string"
                    },
                    "region": {
                        "type": "string"
                    },
                    "pairingCode": {
                        "type": "string"
                    },
                    "expires": {
                        "type": "number"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "Connection": {
                "type": "object",
                "properties": {
                    "transportProtocol": {
                        "$ref": "#/components/schemas/TransportProtocol"
                    }
                }
            },
            "DeprovisionResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "DeviceConfiguration": {
                "type": "object",
                "properties": {
                    "channels": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ChannelConfiguration"
                        }
                    },
                    "simpleSettings": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/IdAndValue"
                        }
                    }
                },
                "required": [
                    "channels"
                ]
            },
            "DeviceEncryption": {
                "oneOf": [
                    {
                        "type": "object",
                        "title": "aes128",
                        "properties": {
                            "aes128": {
                                "$ref": "#/components/schemas/DeviceEncryptionAes128"
                            }
                        },
                        "required": [
                            "aes128"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "aes256",
                        "properties": {
                            "aes256": {
                                "$ref": "#/components/schemas/DeviceEncryptionAes256"
                            }
                        },
                        "required": [
                            "aes256"
                        ]
                    }
                ]
            },
            "DeviceEncryptionAes128": {
                "type": "object",
                "properties": {
                    "passcode": {
                        "type": "string",
                        "maxLength": 32,
                        "minLength": 32,
                        "pattern": "^[a-fA-F0-9]+$",
                        "description": "A 32-character hexadecimal string."
                    }
                },
                "required": [
                    "passcode"
                ]
            },
            "DeviceEncryptionAes256": {
                "type": "object",
                "properties": {
                    "passcode": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 64,
                        "pattern": "^[a-fA-F0-9]+$",
                        "description": "A 64-character hexadecimal string."
                    }
                },
                "required": [
                    "passcode"
                ]
            },
            "DeviceRegistration": {
                "type": "object",
                "properties": {
                    "channels": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Channel"
                        }
                    },
                    "simpleSettings": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Setting"
                        }
                    },
                    "thumbnails": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Thumbnail"
                        }
                    }
                },
                "required": [
                    "channels"
                ]
            },
            "DeviceStatus": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StatusValue"
                        }
                    },
                    "channels": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ChannelStatus"
                        }
                    }
                },
                "required": [
                    "status"
                ]
            },
            "DisconnectResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "EnumValues": {
                "type": "object",
                "properties": {
                    "values": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "defaultValue": {
                        "type": "string"
                    }
                },
                "required": [
                    "defaultValue",
                    "values"
                ]
            },
            "ErrorDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "details": {
                        "type": "string"
                    }
                },
                "required": [
                    "details",
                    "message",
                    "type"
                ]
            },
            "GetConfigurationResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    },
                    "configuration": {
                        "$ref": "#/components/schemas/ConfigurationData"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "GetConnectionStatusResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "Health": {
                "type": "object",
                "properties": {
                    "state": {
                        "$ref": "#/components/schemas/healthLevel"
                    },
                    "message": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "componentName": {
                        "type": "string"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "timestamp"
                ]
            },
            "IdAndValue": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                },
                "required": [
                    "key",
                    "value"
                ]
            },
            "ProfileDefinition": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "info": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "info",
                    "name"
                ]
            },
            "RangeValues": {
                "type": "object",
                "properties": {
                    "min": {
                        "type": "number",
                        "format": "float"
                    },
                    "max": {
                        "type": "number",
                        "format": "float"
                    },
                    "defaultValue": {
                        "type": "number",
                        "format": "float"
                    }
                },
                "required": [
                    "defaultValue",
                    "max",
                    "min"
                ]
            },
            "ReportActualConfigurationRequestContent": {
                "type": "object",
                "properties": {
                    "configuration": {
                        "$ref": "#/components/schemas/DeviceConfiguration"
                    }
                },
                "required": [
                    "configuration"
                ]
            },
            "ReportActualConfigurationResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "ReportStatusRequestContent": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/DeviceStatus"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "ReportStatusResponseContent": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "state": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "error": {
                        "$ref": "#/components/schemas/ErrorDetails"
                    }
                },
                "required": [
                    "message",
                    "state",
                    "success"
                ]
            },
            "RistCallerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "$ref": "#/components/schemas/RistStreamIdentifier"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "port": {
                        "type": "number"
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    }
                },
                "required": [
                    "ip",
                    "minimumLatencyMilliseconds",
                    "port"
                ]
            },
            "RistListenerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "$ref": "#/components/schemas/RistStreamIdentifier"
                    },
                    "port": {
                        "type": "number"
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    },
                    "interface": {
                        "type": "string"
                    }
                },
                "required": [
                    "minimumLatencyMilliseconds",
                    "port"
                ]
            },
