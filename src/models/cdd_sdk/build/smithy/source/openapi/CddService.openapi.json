                    "SRT_LISTENER",
                    "SRT_CALLER",
                    "ZIXI_LISTENER",
                    "ZIXI_CALLER",
                    "RIST_CALLER",
                    "RIST_LISTENER"
                ]
            },
            "Thumbnail": {
                "type": "object",
                "properties": {
                    "name": {
