                "oneOf": [
                    {
                        "type": "object",
                        "title": "srtListener",
                        "properties": {
                            "srtListener": {
                                "$ref": "#/components/schemas/SrtListenerTransportProtocol"
                            }
                        },
                        "required": [
                            "srtListener"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "srtCaller",
                        "properties": {
                            "srtCaller": {
                                "$ref": "#/components/schemas/SrtCallerTransportProtocol"
                            }
                        },
                        "required": [
                            "srtCaller"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "ristListener",
                        "properties": {
                            "ristListener": {
                                "$ref": "#/components/schemas/RistListenerTransportProtocol"
                            }
                        },
                        "required": [
                            "ristListener"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "ristCaller",
                        "properties": {
                            "ristCaller": {
                                "$ref": "#/components/schemas/RistCallerTransportProtocol"
                            }
                        },
                        "required": [
                            "ristCaller"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "zixiListener",
                        "properties": {
                            "zixiListener": {
                                "$ref": "#/components/schemas/ZixiListenerTransportProtocol"
                            }
                        },
                        "required": [
                            "zixiListener"
                        ]
                    },
                    {
                        "type": "object",
                        "title": "zixiCaller",
                        "properties": {
                            "zixiCaller": {
                                "$ref": "#/components/schemas/ZixiCallerTransportProtocol"
                            }
                        },
                        "required": [
                            "zixiCaller"
                        ]
                    }
                ]
            },
            "ZixiCallerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "type": "string"
                    },
                    "ip": {
                        "type": "string"
                    },
                    "port": {
                        "type": "number"
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    }
                },
                "required": [
                    "ip",
                    "minimumLatencyMilliseconds",
                    "port",
                    "streamId"
                ]
            },
            "ZixiListenerTransportProtocol": {
                "type": "object",
                "properties": {
                    "streamId": {
                        "type": "string"
                    },
                    "port": {
                        "type": "number"
                    },
                    "minimumLatencyMilliseconds": {
                        "type": "number",
                        "default": 3000
                    },
                    "encryption": {
                        "$ref": "#/components/schemas/DeviceEncryption"
                    },
                    "interface": {
                        "type": "string"
                    }
                },
                "required": [
                    "minimumLatencyMilliseconds",
                    "port",
                    "streamId"
                ]
            },
            "healthLevel": {
                "type": "string",
                "enum": [
                    "HEALTHY",
                    "DEGRADED",
                    "CRITICAL"
                ]
            }
        }
    }
}
