{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/definitions/primitives.json",
  "title": "Node and ID Definitions",
  "$defs": {
    "name": { "type": "string", "maxLength": 20},
    "info": { "type": "string", "maxLength": 80},
    "ip_address": {
      "type": "string",
      "format": "ipv4",
      "description": "A standard IPv4 address."
    },
    "state": {
      "type": "string",
      "default": "IDLE",
      "enum": [
        "ACTIVE",
        "IDLE"
      ]
    },
    "id": {
      "type": "string",
      "description": "Short, locally managed unique identifier (max 100 characters).",
      "maxLength": 100
    },
    "channel_type": {
      "type": "string",
      "enum": [
        "SOURCE",
        "DESTINATION"
      ]
    }
  }
}