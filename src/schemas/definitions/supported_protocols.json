{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/definitions/supported_protocols.json",
  "title": "Output Protocol Definitions",
  "$defs": {
    "supported_protocols": {
      "type": "string",
      "description": "This is the complete list currently supposed by the CDD Protocol.",
      "enum": [
        "srt_listener", "srt_caller", "zixi_listener",
        "zixi_caller", "rist_caller", "rist_listener"
      ]
    },

    "supported_protocols_array": {
      "type": "array",
      "description": "An array where every item must be a valid output protocol string.",
      "items": { "$ref": "#/$defs/supported_protocols" },
      "minItems": 1
    }
  }
}