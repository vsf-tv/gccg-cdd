{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/status-schema.json",
  "title": "Channel Status and Metrics Schema",

  "type": "object",
  "required": ["channels"],
  "properties": {
    "channels": {
      "type": "array",
      "description": "A list of current status and metric readings for each channel.",
      "items": {
        "type": "object",
        "required": ["id", "state", "status"],
        "properties": {
          "id": {
            "$ref": "definitions/primitives.json#/$defs/id",
            "description": "The unique identifier of the channel."
          },
          "state": {
            "$ref": "definitions/primitives.json#/$defs/state",
            "description": "The current operational state (e.g., active, idle, error)."
          },
          "status": {
            "$ref": "#/$defs/array_of_name_and_value"
          },
          "connection": {
            "type": "object",
            "properties": {
              "metrics": {
                "description": "Real-time transport metrics for the channel's active protocol.",
                "$ref": "definitions/transport_protocols/arq_metrics.json#/$defs/arq_metrics"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "name_and_value": {
      "type": "object",
      "description": "A simple name:value pair",
      "required": ["name", "info", "value"],
      "properties": {
        "name": {"$ref": "definitions/primitives.json#/$defs/name"},
        "info": {"$ref": "definitions/primitives.json#/$defs/info"},
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "array_of_name_and_value": {
      "type": "array",
      "description": "An array of <name:list of value>",
      "items": {
        "$ref": "#/$defs/name_and_value"
      }
    }
  }
}