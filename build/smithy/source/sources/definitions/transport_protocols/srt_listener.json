{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/definitions/transport_protocols/srt_listener.json",
  "title": "SRT Listener Protocol Configuration",
  "$defs": {
    "srt_listener": {
      "description": "Note: stream_id is not required in the schema but may be by the endpoint",
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string"
        },
        "ip": {
          "$ref": "../primitives.json#/$defs/ip_address"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 49151
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "encryption": {
          "description": "encryption is required, but can specify encryption: {}",
          "$ref": "../encryption.json#/$defs/encryption"
        }
      },
      "required": [
        "ip",
        "port",
        "latency_ms",
        "encryption"
      ],
      "additionalProperties": false
    }
  }
}