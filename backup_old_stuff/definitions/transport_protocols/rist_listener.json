{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/definitions/transport_protocols/rist_listener.json",
  "title": "RIST Listener Protocol Configuration",
  "$defs": {
    "rist_listener": {
      "type": "object",
      "description": "Configuration for receiving streams via RIST (Reliable Internet Stream Transport).",
      "description": "Note: stream_id is not required in the schema but may be by the endpoint",
      "properties": {
        "stream_id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "The RIST operating mode.",
          "enum": ["simple", "main"]
        },
        "ip": {
          "description": "The local IP address to listen on.",
          "$ref": "../primitives.json#/$defs/ip_address"
        },
        "port": {
          "type": "integer",
          "description": "The local port to listen on.",
          "minimum": 1024,
          "maximum": 49151
        },
        "latency_ms": {
          "type": "integer",
          "description": "Target buffer size/latency for error correction (in milliseconds).",
          "minimum": 50,
          "maximum": 60000
        },
        "encryption": {
          "description": "Encryption configuration for the RIST stream.",
          "$ref": "../encryption.json#/$defs/encryption"
        }
      },
      "required": [
        "mode",
        "ip",
        "port",
        "latency_ms",
        "encryption"
      ],
      "additionalProperties": false
    }
  }
}