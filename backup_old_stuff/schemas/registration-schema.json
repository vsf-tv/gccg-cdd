{
  "$schema": "http://json-schema.org/draft/2019-09/schema",
  "$id": "http://example.com/schemas/registration-schema.json",
  "title": "Registration Schema",
  "type": "object",
  "required": ["channels"],
  "properties": {
    "channels": {
      "type": "array",
      "description": "A list of defined channel objects.",
      "items": {
        "type": "object",
        "required": ["name", "id"],
        "properties": {
          "name": { "type": "string" },
          "id": { "$ref": "definitions/primitives.json#/$defs/id"},
          "channel_type": { "$ref": "definitions/primitives.json#/$defs/channel_type"},
          "settings": { "$ref": "#/$defs/array_of_id_and_values"},
          "setting_profiles": {"$ref": "#/$defs/profiles"},
          "connection_protocols": { "$ref": "definitions/supported_protocols.json#/$defs/supported_protocols_array"}
        },
        "additionalProperties": false
      }
    },
    "thumbnails": {
      "description": "Optional metadata for thumbnail configuration.",
      "$ref": "#/$defs/thumbnails"
    }
  },

  "$defs": {
    "profiles": {
      "type": "array",
      "description": "A list of defined setting profiles.",
      "items": {
        "type": "object",
        "required": ["name", "id", "info"],
        "properties": {
          "name": { "type": "string" },
          "id": { "$ref": "definitions/primitives.json#/$defs/id"},
          "info": { "type":  "string"}
        },
        "additionalProperties": false
      }
    },
    "thumbnails": {
      "description": "Thumbnail available if present",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The friendly name of the thumbnail configuration."
          },
          "id": {
            "$ref": "definitions/primitives.json#/$defs/id"
          },
          "local_path": {
            "description": "Protocol supports jpg or png type for thumbnail images.",
            "type": "string",
            "pattern": "^(?:/[^/]+)*/?[^/]+\\.(jpg|png)$"
          }
        },
        "required": [
          "name",
          "id",
          "local_path"
        ],
        "additionalProperties": false
      }
    },
    "item_and_array_of_values": {
      "type": "object",
      "description": "Specifies a field:list-of-possible-values.",
      "description": "Name and info are intended as customer-visible UI descriptors, so be precise please.",
      "required": ["id", "name", "info"],
      "properties": {
        "id": { "$ref": "definitions/primitives.json#/$defs/id" },
        "name": {"$ref": "definitions/primitives.json#/$defs/name"},
        "info":{"$ref": "definitions/primitives.json#/$defs/info"},
        "enums": {
          "type": "object",
          "required": ["values", "default_value"],
          "properties": {
            "values": {
              "type": "array",
              "description": "Enumerates the possible values for this node.  The list that must contain only string values.",
              "items": {
                "type": "string"
              }
            },
            "default_value": {
              "type": "string"
            }
          }
        },
        "ranges": {
          "type": "object",
          "required": ["min", "max", "default_value"],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default_value": {
              "type": "number"
            }
          }
        }
      },
      "oneOf": [
        { "required": ["enums"] },
        { "required": ["ranges"] }
      ],
      "additionalProperties": false
    },
    "array_of_id_and_values": {
      "type": "array",
      "description": "An array of id:id_and_values",
      "items": {
        "$ref": "#/$defs/item_and_array_of_values"
      }
    }
  },
  "additionalProperties": false
}